<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="paper">#F4F1E8</color>
    <color name="entry_paper">#EEEEE2</color>
    <color name="ink">#354A42</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:windowBackground">@color/entry_paper</item>
        <item name="android:statusBarColor">@color/entry_paper</item>
        <item name="android:navigationBarColor">@color/entry_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
